generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String
  refreshToken String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  followUps CustomerFollowUp[] @relation("FollowUpCreator")
  movements StockMovement[]
  challans  SalesChallan[]
}

model Customer {
  id             String           @id @default(uuid())
  name           String
  mobile         String           @unique
  email          String?
  businessName   String
  gstNumber      String?          @unique
  type           String
  status         String           @default("LEAD")
  address        String
  notes          String?
  nextFollowUpAt DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  followUps CustomerFollowUp[]
  challans  SalesChallan[]

  @@index([name, status])
}

model CustomerFollowUp {
  id           String   @id @default(uuid())
  customerId   String
  followUpDate DateTime
  notes        String
  createdById  String
  createdAt    DateTime @default(now())

  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdBy User     @relation("FollowUpCreator", fields: [createdById], references: [id])

  @@index([followUpDate])
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Warehouse {
  id        String    @id @default(uuid())
  name      String    @unique
  location  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id            String   @id @default(uuid())
  name          String
  sku           String   @unique
  imageUrl      String?
  unitPrice     Float
  currentStock  Int      @default(0)
  minimumStock  Int      @default(0)
  categoryId    String
  warehouseId   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category     Category @relation(fields: [categoryId], references: [id])
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id])
  movements    StockMovement[]
  challanItems SalesChallanItem[]

  @@index([name, categoryId])
}

model StockMovement {
  id              String       @id @default(uuid())
  productId       String
  quantityChanged Int
  type            String
  reason          String
  createdById     String
  createdAt       DateTime     @default(now())

  product   Product @relation(fields: [productId], references: [id])
  createdBy User    @relation(fields: [createdById], references: [id])

  @@index([productId, createdAt])
}

model SalesChallan {
  id                 String        @id @default(uuid())
  challanNumber      String        @unique
  customerId         String
  status             String        @default("DRAFT")
  totalQuantity      Int           @default(0)
  paymentStatus      String        @default("UNPAID")
  paymentMode        String?
  paidAmount         Float         @default(0)
  outstandingBalance Float         @default(0)
  createdById        String
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  customer  Customer @relation(fields: [customerId], references: [id])
  createdBy User     @relation(fields: [createdById], references: [id])
  items     SalesChallanItem[]

  @@index([status, createdAt])
}

model SalesChallanItem {
  id                  String   @id @default(uuid())
  challanId           String
  productId           String
  productNameSnapshot String
  skuSnapshot         String
  unitPriceSnapshot   Float
  quantity            Int

  challan SalesChallan @relation(fields: [challanId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id])
}