{
  "name": "nexus-operations-portal",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "dev:setup": "powershell -ExecutionPolicy Bypass -File ./scripts/dev-setup.ps1",
    "dev:full": "npm run dev:setup",
    "build": "npm run build -w backend && npm run build -w frontend",
    "test": "npm run test -w backend",
    "db:migrate": "npm run prisma:migrate -w backend",
    "db:seed": "npm run prisma:seed -w backend"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "concurrently": "^9.1.2",
    "pglite-server": "^0.1.5"
  }
}
